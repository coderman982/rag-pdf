# Copy to .env and fill in. Never commit the real .env.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Inngest ----------------------------------------------------------------
# true  -> local/self-hosted Inngest dev server (no keys needed)
# false -> Inngest Cloud (requires EVENT_KEY + SIGNING_KEY)
INNGEST_DEV=true
INNGEST_APP_ID=rag_app

# Only needed when INNGEST_DEV=false
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_API_BASE_URL=https://api.inngest.com
# INNGEST_EVENT_API_BASE_URL=https://inn.gs
# INNGEST_ENV=

# --- Models -----------------------------------------------------------------
OPENAI_EMBED_MODEL=text-embedding-3-large
RAG_LLM_MODEL=gpt-4o-mini

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=docs
QDRANT_DIM=3072

# --- Uploads ----------------------------------------------------------------
# Must resolve to the SAME path on the Streamlit host and the Inngest worker
# host, because the ingest event carries an absolute file path.
UPLOADS_DIR=uploads